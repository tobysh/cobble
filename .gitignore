# --- Rust / Cargo ---
/target/
**/target/
Cargo.lock.bak
/.claude/
# --- Node / pnpm ---
node_modules/
**/node_modules/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.local

# --- Frontend build output ---
frontend/dist/
frontend/dist-ssr/

# --- Tauri ---
src-tauri/gen/schemas/
src-tauri/target/

# --- Cobble app data (never belongs in the repo) ---
# A workspace opened by the app during local dev/testing.
.cobble/
*.cobble-workspace/

# --- WASM plugin build artifacts ---
plugins/*/target/
plugins/*/*.wasm
!plugins/*/dist/*.wasm

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Logs ---
logs/
*.log
